#line 1 "ROUNDING.cbl"
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ROUNDING.


 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 R1 PIC S9(3)V9.
 01 T1 PIC S9(3)V9.
 01 P1 PIC S9(3)V9 COMP-3.
 01 B1 PIC S9(3)V9 COMP.
 01 A PIC S9(3)V99 VALUE 2.45.
 01 M PIC S9(3)V99 VALUE -2.45.
 01 H PIC S9(3)V99 VALUE 2.55.
 01 I3 PIC S9(3).
 PROCEDURE DIVISION.
 MAIN-PARA.
 COMPUTE R1 ROUNDED = A
 COMPUTE T1 = A
 DISPLAY R1 " " T1
 COMPUTE R1 ROUNDED = M
 COMPUTE T1 = M
 DISPLAY R1 " " T1
 COMPUTE R1 ROUNDED = H
 DISPLAY R1
 COMPUTE R1 ROUNDED = -0.04
 COMPUTE T1 = -0.04
 DISPLAY R1 " " T1
 COMPUTE R1 ROUNDED = -0.05
 DISPLAY R1
 COMPUTE P1 ROUNDED = M
 COMPUTE B1 ROUNDED = M
 DISPLAY P1 " " B1
 MOVE 1 TO P1 B1 R1
 ADD A TO P1 ROUNDED
 ADD A TO B1 ROUNDED
 ADD A TO R1 ROUNDED
 DISPLAY P1 " " B1 " " R1
 MOVE 1 TO P1 R1
 SUBTRACT M FROM P1 ROUNDED
 SUBTRACT M FROM R1 ROUNDED
 DISPLAY P1 " " R1
 MOVE 7 TO I3
 DIVIDE 2 INTO I3 ROUNDED
 DISPLAY I3
 MOVE -7 TO I3
 DIVIDE 2 INTO I3 ROUNDED
 DISPLAY I3
 MOVE -7 TO I3
 DIVIDE 2 INTO I3
 DISPLAY I3
 MOVE 3 TO R1
 MULTIPLY 0.35 BY R1 ROUNDED
 DISPLAY R1
 COMPUTE I3 ROUNDED = 2 / 3
 DISPLAY I3
 COMPUTE I3 ROUNDED = -998.5
 DISPLAY I3
 STOP RUN.
