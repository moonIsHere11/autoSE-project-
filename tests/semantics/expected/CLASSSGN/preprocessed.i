#line 1 "CLASSSGN.cbl"
 IDENTIFICATION DIVISION.
 PROGRAM-ID. CLASSSGN.



 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 X PIC X(4).
 01 U PIC 9(3).
 01 SG PIC S9(3) VALUE -5.
 01 PK PIC S9(3) COMP-3 VALUE 0.
 01 A PIC S9(3) VALUE 5.
 01 B PIC S9(3) VALUE 7.
 01 UV PIC 9V9 VALUE 0.5.
 PROCEDURE DIVISION.
 MAIN-PARA.
 MOVE "1234" TO X
 IF X IS NUMERIC DISPLAY "X NUM" 
 ELSE DISPLAY "X NOT NUM" END-IF
 MOVE "12 4" TO X
 IF X IS NUMERIC DISPLAY "X NUM" 
 ELSE DISPLAY "X NOT NUM" END-IF
 MOVE "AbC " TO X
 IF X IS ALPHABETIC DISPLAY "X ALPHA" END-IF
 IF X IS ALPHABETIC-UPPER DISPLAY "X UPPER" END-IF
 IF X IS NOT ALPHABETIC-LOWER DISPLAY "X NOT LOWER" END-IF
 MOVE "ABC " TO X
 IF X ALPHABETIC-UPPER DISPLAY "X UPPER" END-IF
 IF SG IS NUMERIC DISPLAY "SG NUM" END-IF
 IF SG IS NEGATIVE DISPLAY "SG NEG" END-IF
 IF SG IS NOT POSITIVE DISPLAY "SG NOT POS" END-IF
 IF PK IS ZERO DISPLAY "PK ZERO" END-IF
 MOVE "12A" TO U (1:3)
 IF U IS NOT NUMERIC DISPLAY "U NOT NUM" END-IF
 IF A = 1 OR 5 OR 9 DISPLAY "ABBR1" END-IF
 IF A > 1 AND < 6 DISPLAY "ABBR2" END-IF
 IF A > 1 AND NOT > 4 DISPLAY "ABBR3" 
 ELSE DISPLAY "NO3" END-IF
 IF NOT A = B DISPLAY "NOT1" END-IF
 IF A NOT = B AND B > A DISPLAY "NOT2" END-IF
 IF A = 5 AND B = 6 OR 7 DISPLAY "ABBR4" END-IF
 IF A + 2 = B DISPLAY "EXPR" END-IF
 IF (A = 5 OR B = 0) AND NOT (A > B) DISPLAY "PAREN" END-IF
 IF UV < -607.57 DISPLAY "FOLDED LESS" END-IF
 IF UV > -607.57 DISPLAY "GREATER" 
 ELSE DISPLAY "NOT GT" END-IF
 IF A = 1234 DISPLAY "EQ BIG" ELSE DISPLAY "NE BIG" END-IF
 IF A < 1234 DISPLAY "LT BIG" END-IF
 IF X = "ABCDE" DISPLAY "EQ LONG" 
 ELSE DISPLAY "NE LONG" END-IF
 IF X = "ABC" DISPLAY "EQ PAD" END-IF
 STOP RUN.
