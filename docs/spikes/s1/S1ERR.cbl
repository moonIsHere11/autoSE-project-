       IDENTIFICATION DIVISION.
       PROGRAM-ID. S1ERR.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO "MISSING.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD IN-FILE.
       01 IN-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01 WS-X  PIC 9(3) VALUE 5.
       01 WS-Z  PIC 9(3) VALUE 0.
       PROCEDURE DIVISION.
           DIVIDE WS-Z INTO WS-X
           DISPLAY "AFTER DIVIDE X=" WS-X
           OPEN INPUT IN-FILE
           DISPLAY "AFTER OPEN"
           STOP RUN.
