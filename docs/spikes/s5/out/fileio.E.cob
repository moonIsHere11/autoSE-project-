#line 1 "fileio.cbl"

 IDENTIFICATION DIVISION.
 PROGRAM-ID. FILEIO.
 ENVIRONMENT DIVISION.
 INPUT-OUTPUT SECTION.
 FILE-CONTROL.
 SELECT CUST-FILE ASSIGN TO "custin.dat" 
 ORGANIZATION IS LINE SEQUENTIAL
 FILE STATUS IS WS-CUST-STATUS.
 SELECT RPT-FILE ASSIGN TO "rptout.dat" 
 ORGANIZATION LINE SEQUENTIAL.
 DATA DIVISION.
 FILE SECTION.
 FD CUST-FILE.
 
#line 1 "CUSTREC.CPY"

 01 CUST-REC.
 05 CUST-ID PIC 9(5).
 05 FILLER PIC X.
 05 CUST-NAME PIC X(20).
 05 FILLER PIC X.
 05 CUST-BALANCE PIC S9(5)V99
 SIGN LEADING SEPARATE.
 05 FILLER PIC X.
 05 CUST-TYPE PIC X.
 88 CUST-RETAIL VALUE 'R'.
 88 CUST-WHOLESALE VALUE 'W'.
#line 15 "fileio.cbl"

 FD RPT-FILE
 RECORD CONTAINS 60 CHARACTERS.
 01 RPT-REC PIC X(60).
 WORKING-STORAGE SECTION.
 01 WS-CUST-STATUS PIC XX.
 88 CUST-OK VALUE '00'.
 01 WS-EOF-SW PIC X VALUE 'N'.
 88 WS-EOF VALUE 'Y'.
 01 WS-COUNTS.
 05 WS-READ-CNT PIC 9(5) COMP VALUE ZERO.
 05 WS-RETAIL-CNT PIC 9(5) COMP VALUE ZERO.
 05 WS-WHOLE-CNT PIC 9(5) COMP VALUE ZERO.
 01 WS-TOTAL-BAL PIC S9(7)V99 COMP-3 VALUE ZERO.
 01 WS-DETAIL.
 05 DET-ID PIC 9(5).
 05 FILLER PIC X VALUE SPACE.
 05 DET-NAME PIC X(20).
 05 FILLER PIC X VALUE SPACE.
 05 DET-BAL PIC +ZZ,ZZ9.99.
 05 FILLER PIC X VALUE SPACE.
 05 DET-KIND PIC X(9).
 05 FILLER PIC X(13) VALUE SPACES.
 01 WS-TRAILER.
 05 FILLER PIC X(8) VALUE "RECORDS=".
 05 TRL-CNT PIC ZZZZ9.
 05 FILLER PIC X(7) VALUE " TOTAL=".
 05 TRL-BAL PIC -Z,ZZZ,ZZ9.99.
 05 FILLER PIC X(27) VALUE ALL "-".
 PROCEDURE DIVISION.
 0000-MAIN SECTION.
 0000-START.
 OPEN INPUT CUST-FILE
 OUTPUT RPT-FILE
 IF NOT CUST-OK
 DISPLAY "OPEN FAILED, STATUS=" WS-CUST-STATUS
 STOP RUN
 END-IF
 PERFORM 1000-READ
 PERFORM 2000-PROCESS THRU 2000-EXIT
 UNTIL WS-EOF
 MOVE WS-READ-CNT TO TRL-CNT
 MOVE WS-TOTAL-BAL TO TRL-BAL
 WRITE RPT-REC FROM WS-TRAILER
 CLOSE CUST-FILE RPT-FILE
 DISPLAY "READ=" WS-READ-CNT
 " RETAIL=" WS-RETAIL-CNT
 " WHOLE=" WS-WHOLE-CNT
 STOP RUN.
 1000-READ.
 READ CUST-FILE
 AT END
 MOVE 'Y' TO WS-EOF-SW
 NOT AT END
 ADD 1 TO WS-READ-CNT
 END-READ.
 2000-PROCESS.
 MOVE CUST-ID TO DET-ID
 MOVE CUST-NAME TO DET-NAME
 MOVE CUST-BALANCE TO DET-BAL
 ADD CUST-BALANCE TO WS-TOTAL-BAL
 EVALUATE TRUE
 WHEN CUST-RETAIL
 ADD 1 TO WS-RETAIL-CNT
 MOVE "RETAIL" TO DET-KIND
 WHEN CUST-WHOLESALE
 ADD 1 TO WS-WHOLE-CNT
 MOVE "WHOLESALE" TO DET-KIND
 WHEN OTHER
 MOVE "UNKNOWN" TO DET-KIND
 END-EVALUATE
 WRITE RPT-REC FROM WS-DETAIL
 PERFORM 1000-READ.
 2000-EXIT.
 EXIT.
