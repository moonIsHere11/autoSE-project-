000100* FILEIO - spike S5 sample 2: LINE SEQUENTIAL in, report out.
000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. FILEIO.                                              FIO00003
000400 ENVIRONMENT DIVISION.
000500 INPUT-OUTPUT SECTION.
000600 FILE-CONTROL.
000700     SELECT CUST-FILE ASSIGN TO "custin.dat"
000800         ORGANIZATION IS LINE SEQUENTIAL
000900         FILE STATUS IS WS-CUST-STATUS.
001000     SELECT RPT-FILE ASSIGN TO "rptout.dat"
001100         ORGANIZATION LINE SEQUENTIAL.
001200 DATA DIVISION.
001300 FILE SECTION.
001400 FD  CUST-FILE.
001500     COPY CUSTREC REPLACING ==:PFX:== BY ==CUST==.                FIO00015
001600 FD  RPT-FILE
001700     RECORD CONTAINS 60 CHARACTERS.
001800 01  RPT-REC                 PIC X(60).
001900 WORKING-STORAGE SECTION.
002000 01  WS-CUST-STATUS          PIC XX.
002100     88  CUST-OK             VALUE '00'.
002200 01  WS-EOF-SW               PIC X VALUE 'N'.
002300     88  WS-EOF              VALUE 'Y'.
002400 01  WS-COUNTS.
002500     05  WS-READ-CNT         PIC 9(5) COMP VALUE ZERO.
002600     05  WS-RETAIL-CNT       PIC 9(5) COMP VALUE ZERO.
002700     05  WS-WHOLE-CNT        PIC 9(5) COMP VALUE ZERO.
002800 01  WS-TOTAL-BAL            PIC S9(7)V99 COMP-3 VALUE ZERO.
002900 01  WS-DETAIL.
003000     05  DET-ID              PIC 9(5).
003100     05  FILLER              PIC X VALUE SPACE.
003200     05  DET-NAME            PIC X(20).
003300     05  FILLER              PIC X VALUE SPACE.
003400     05  DET-BAL             PIC +ZZ,ZZ9.99.
003500     05  FILLER              PIC X VALUE SPACE.
003600     05  DET-KIND            PIC X(9).
003700     05  FILLER              PIC X(13) VALUE SPACES.
003800 01  WS-TRAILER.
003900     05  FILLER              PIC X(8) VALUE "RECORDS=".
004000     05  TRL-CNT             PIC ZZZZ9.
004100     05  FILLER              PIC X(7) VALUE " TOTAL=".
004200     05  TRL-BAL             PIC -Z,ZZZ,ZZ9.99.
004300     05  FILLER              PIC X(27) VALUE ALL "-".
004400 PROCEDURE DIVISION.
004500 0000-MAIN SECTION.
004600 0000-START.
004700     OPEN INPUT CUST-FILE                                         FIO00047
004800          OUTPUT RPT-FILE
004900     IF NOT CUST-OK
005000         DISPLAY "OPEN FAILED, STATUS=" WS-CUST-STATUS
005100         STOP RUN
005200     END-IF
005300     PERFORM 1000-READ
005400     PERFORM 2000-PROCESS THRU 2000-EXIT
005500         UNTIL WS-EOF
005600     MOVE WS-READ-CNT TO TRL-CNT
005700     MOVE WS-TOTAL-BAL TO TRL-BAL
005800     WRITE RPT-REC FROM WS-TRAILER
005900     CLOSE CUST-FILE RPT-FILE
006000     DISPLAY "READ="    WS-READ-CNT
006100             " RETAIL=" WS-RETAIL-CNT
006200             " WHOLE="  WS-WHOLE-CNT
006300     STOP RUN.
006400 1000-READ.
006500     READ CUST-FILE
006600         AT END
006700             MOVE 'Y' TO WS-EOF-SW
006800         NOT AT END
006900             ADD 1 TO WS-READ-CNT
007000     END-READ.
007100 2000-PROCESS.
007200     MOVE CUST-ID      TO DET-ID
007300     MOVE CUST-NAME    TO DET-NAME
007400     MOVE CUST-BALANCE TO DET-BAL
007500     ADD CUST-BALANCE  TO WS-TOTAL-BAL
007600     EVALUATE TRUE
007700         WHEN CUST-RETAIL
007800             ADD 1 TO WS-RETAIL-CNT
007900             MOVE "RETAIL" TO DET-KIND
008000         WHEN CUST-WHOLESALE
008100             ADD 1 TO WS-WHOLE-CNT
008200             MOVE "WHOLESALE" TO DET-KIND
008300         WHEN OTHER
008400             MOVE "UNKNOWN" TO DET-KIND
008500     END-EVALUATE
008600     WRITE RPT-REC FROM WS-DETAIL
008700     PERFORM 1000-READ.
008800 2000-EXIT.
008900     EXIT.
